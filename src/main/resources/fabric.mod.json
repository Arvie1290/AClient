{
  "schemaVersion": 1,
  "id": "ave-addon",
  "version": "${version}",
  "name": "AVE Addon",
  "description": "An Next Gen from AClient bro.",
  "authors": [
    "gamercaz"
  ],
  "contact": {
    "sources": "https://github.com/MeteorDevelopment/meteor-addon-template"
  },
  "icon": "assets/ave/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.ave.addon.AVEAddon"
    ]
  },
  "mixins": [
    "ave.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "225,25,25",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=21",
    "minecraft": ["${mc_version}"],
    "meteor-client": "*"
  }
}
